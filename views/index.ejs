<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Document</title>
</head>
<body>
		<% if(currentUser) { %>
		<h1>Welcome Back <%= currentUser.name %></h1>
