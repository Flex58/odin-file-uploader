<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= file.name %></title>
</head>
<body>
		<div>
			<h1><%= file.name %></h1>
				<a href="/files/<%= file.folderId %>/<%= file.id %>/download"><button type="button">Download</button></a>
				<a href="/files/<%= file.folderId %>/<%= file.id %>/delete"><button type="button">Delete</button></a>
		</div>
		<div>
			<img src="" alt="Image of <%= file.name %>">
			<p>Size: <%= file.size %></p>
			<p>Date: <%= file.uploadTime %></p>
		</div>
</body>
</html>
